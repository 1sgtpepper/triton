+@triton.jit
+def atomic_rmw_ws_kernel(
+    a_ptr,
+    b_ptr,
+    out_ptr,
+    atomic_ptr,
+    M: tl.constexpr,
+    N: tl.constexpr,
+    K: tl.constexpr,
+    WARP_SPECIALIZE: tl.constexpr,
+):
+    om = tl.arange(0, M)
+    on = tl.arange(0, N)
+    ok = tl.arange(0, K)
+    acc = tl.zeros([M, N], dtype=tl.float32)
